avg_switch <- mean(teams$Switch)

ggplot(teams, aes(x = Switch, y = Opp)) +
  
  # Bars
  geom_col(aes(fill = bar_color), width = 0.7, alpha = 0.85) +
  
  # Average line
  geom_vline(xintercept = avg_switch, linetype = "dashed",
             color = "#475569", linewidth = 0.7) +
  annotate("text", x = avg_switch + 0.6, y = 0.61,
           label = paste0("Avg: ", round(avg_switch, 1), "%"),
           hjust = 0, size = 2.8, color = "#475569", fontface = "italic") +
  
  # Percentage labels
  geom_text(aes(label = paste0(Switch, "%"), color = bar_color),
            hjust = -0.2, fontface = "bold", size = 3.0) +
  
  # Team logos to the left
  geom_from_path(aes(path = logo_url, x = -4.5),
                 width = 0.030, hjust = 0.5) +
  
  scale_fill_identity() +
  scale_color_identity() +
  
  scale_x_continuous(
    limits = c(-8, 65),
    breaks = seq(0, 60, 10),
    labels = function(x) ifelse(x < 0, "", paste0(x, "%")),
    expand = c(0, 0)
  ) +
  
  # Taller plot via aspect ratio
  coord_fixed(ratio = 1.6) +
  
  labs(
    title    = "Ball Screen Switch% vs New York Knicks — 2025-26",
    subtitle = "Base screener coverage · how often each opponent switched on Knicks ball screens",
    caption  = "Data & Visual by ShaxNBA",
    x        = "Switch %",
    y        = NULL
  ) +
  
  theme_minimal(base_size = 12, base_family = "sans") +
  theme(
    plot.background    = element_rect(fill = "floralwhite", color = "floralwhite"),
    panel.background   = element_rect(fill = "floralwhite", color = NA),
