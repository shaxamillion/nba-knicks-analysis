# Load required libraries
library(ggplot2)
library(dplyr)
library(ggimage)

# Create dataset with Brunson attack frequency and team records
brunson_attack <- data.frame(
  Team = c("OKC", "LAC", "LAL", "ATL", "NOP", "HOU", "IND", "UTA", "SAS", 
           "CHI", "SAC", "MEM", "BOS", "ORL", "PHI", "DET", "MIL", "DEN", 
           "PHX", "CHA", "TOR", "CLE", "MIA", "MIN"),
  Games = c(2, 2, 2, 3, 2, 2, 4, 2, 3, 4, 2, 2, 4, 4, 4, 3, 3, 2, 2, 4, 5, 3, 4, 2),
  Brunson_Attack_Pct = c(16.7, 6.2, 13.3, 13.8, 8.0, 23.9, 23.6, 11.4, 17.5,
                         3.0, 2.4, 11.9, 21.6, 13.8, 17.8, 20.4, 7.2, 13.0,
                         10.8, 10.5, 9.7, 15.9, 1.7, 3.7),
  Team_Wins = c(52, 34, 42, 36, 22, 41, 15, 20, 49, 27, 17, 23, 44, 38, 36,
                48, 27, 41, 39, 34, 37, 41, 38, 41),
  Team_GP = c(67, 67, 67, 67, 68, 66, 67, 67, 67, 67, 68, 66, 67, 66, 67,
              66, 66, 68, 67, 68, 66, 67, 68, 67),
  stringsAsFactors = FALSE
) %>%
  filter(Brunson_Attack_Pct > 0) %>%  # Exclude 0.0% teams (GSW, WSH)
  mutate(
    Win_Pct = Team_Wins / Team_GP * 100,
    # NBA team IDs for logo URLs
    team_id = case_when(
      Team == "OKC" ~ "1610612760",
      Team == "LAC" ~ "1610612746",
      Team == "LAL" ~ "1610612747",
      Team == "ATL" ~ "1610612737",
      Team == "NOP" ~ "1610612740",
      Team == "HOU" ~ "1610612745",
      Team == "IND" ~ "1610612754",
      Team == "UTA" ~ "1610612762",
      Team == "SAS" ~ "1610612759",
      Team == "CHI" ~ "1610612741",
      Team == "SAC" ~ "1610612758",
      Team == "MEM" ~ "1610612763",
      Team == "BOS" ~ "1610612738",
      Team == "ORL" ~ "1610612753",
      Team == "PHI" ~ "1610612755",
      Team == "DET" ~ "1610612765",
      Team == "MIL" ~ "1610612749",
      Team == "DEN" ~ "1610612743",
      Team == "PHX" ~ "1610612756",
      Team == "CHA" ~ "1610612766",
      Team == "TOR" ~ "1610612761",
      Team == "CLE" ~ "1610612739",
      Team == "MIA" ~ "1610612748",
      Team == "MIN" ~ "1610612750"
    ),
    logo_url = paste0("https://cdn.nba.com/logos/nba/", team_id, "/primary/L/logo.svg")
  )

# Calculate correlation
correlation <- cor(brunson_attack$Brunson_Attack_Pct, brunson_attack$Win_Pct)

# Create the scatter plot
ggplot(brunson_attack, aes(x = Brunson_Attack_Pct, y = Win_Pct)) +
  # Add reference lines
  geom_hline(yintercept = 50, 
             linetype = "dashed", 
             color = "#7F8C8D", 
             linewidth = 0.6, 
             alpha = 0.5) +
  geom_vline(xintercept = median(brunson_attack$Brunson_Attack_Pct), 
             linetype = "dashed", 
             color = "#7F8C8D", 
             linewidth = 0.6, 
             alpha = 0.5) +
  
  # Add team logos
  geom_image(aes(image = logo_url), size = 0.09, asp = 1.3) +
  
  # Axis formatting
  scale_x_continuous(
    breaks = seq(0, 25, 5),
    labels = function(x) paste0(x, "%"),
    limits = c(0, 26)
  ) +
  scale_y_continuous(
    breaks = seq(20, 80, 10),
    labels = function(x) paste0(x, "%"),
    limits = c(20, 80)
  ) +
  
  # Add quadrant labels
  annotate("text", x = 2, y = 75, 
           label = "Good Teams\nRarely Attack Brunson", 
           size = 3.5, color = "#888888", fontface = "italic", 
           hjust = 0, lineheight = 0.9) +
  annotate("text", x = 24, y = 28, 
           label = "Bad Teams\nAttack Brunson Often", 
           size = 3.5, color = "#888888", fontface = "italic", 
           hjust = 1, lineheight = 0.9) +
  
  # Labels
  labs(
    title = "Brunson Attack Frequency vs Team Success",
    subtitle = "Do better teams target Brunson more?",
    x = "Brunson Attack Frequency (% of possessions)",
    y = "Team Win Percentage",
    caption = "Data via ShaxNBA | Each logo represents opponent team"
  ) +
  
  # Theme
  theme_minimal(base_size = 14, base_family = "sans") +
  theme(
    plot.background = element_rect(fill = "#FAF9F6", color = NA),
    panel.background = element_rect(fill = "#FAF9F6", color = NA),
    panel.grid.major = element_line(color = "#E0E0E0", linewidth = 0.4),
    panel.grid.minor = element_blank(),
    
    plot.title = element_text(
      hjust = 0.5,
      face = "bold",
      color = "#2C3E50",
      size = 20,
      margin = margin(b = 5)
    ),
    plot.subtitle = element_text(
      hjust = 0.5,
      color = "#7F8C8D",
      size = 11,
      margin = margin(b = 25)
    ),
    plot.caption = element_text(
      size = 9,
      color = "#95A5A6",
      hjust = 0.5,
      margin = margin(t = 15)
    ),
    
    axis.title = element_text(face = "bold", color = "#34495E", size = 12),
    axis.text = element_text(color = "#2C3E50", face = "bold", size = 11),
    axis.title.x = element_text(margin = margin(t = 12)),
    axis.title.y = element_text(margin = margin(r = 12)),
    
    plot.margin = margin(25, 25, 25, 25)
  )

print(last_plot())

# Print summary statistics
cat("\n=== Brunson Attack Frequency vs Team Success ===\n")
cat(sprintf("Teams analyzed: %d (excluded GSW, WSH at 0%%)\n", nrow(brunson_attack)))
cat(sprintf("Correlation: %.3f\n", correlation))
cat(sprintf("Median attack frequency: %.1f%%\n", median(brunson_attack$Brunson_Attack_Pct)))
cat(sprintf("Median team win%%: %.1f%%\n", median(brunson_attack$Win_Pct)))

cat("\n=== Top 5: Teams That Attack Brunson Most ===\n")
brunson_attack %>%
  arrange(desc(Brunson_Attack_Pct)) %>%
  select(Team, Games, Brunson_Attack_Pct, Win_Pct) %>%
  head(5) %>%
  print()

cat("\n=== Top 5: Teams That Attack Brunson Least (>0%) ===\n")
brunson_attack %>%
  arrange(Brunson_Attack_Pct) %>%
  select(Team, Games, Brunson_Attack_Pct, Win_Pct) %>%
  head(5) %>%
  print()

cat("\n=== Elite Teams (>60% Win Rate) Attack Frequency ===\n")
brunson_attack %>%
  filter(Win_Pct > 60) %>%
  arrange(desc(Win_Pct)) %>%
  select(Team, Win_Pct, Brunson_Attack_Pct, Games) %>%
  print()

cat("\n=== Poor Teams (<35% Win Rate) Attack Frequency ===\n")
brunson_attack %>%
  filter(Win_Pct < 35) %>%
  arrange(Win_Pct) %>%
  select(Team, Win_Pct, Brunson_Attack_Pct, Games) %>%
  print()
