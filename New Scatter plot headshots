# Reference lines
avg_ppp  <- mean(transition_stats$PPP)
avg_poss <- mean(transition_stats$POSS)

# Plot
ggplot(transition_stats, aes(x = PPP, y = POSS)) +
  
  # Quadrant shading
  annotate("rect", xmin = avg_ppp, xmax = Inf,   ymin = avg_poss, ymax = Inf,
           fill = "#d5f4e6", alpha = 0.35) +
  annotate("rect", xmin = -Inf,   xmax = avg_ppp, ymin = -Inf,    ymax = avg_poss,
           fill = "#fde8e8", alpha = 0.35) +
  
  # Reference lines
  geom_hline(yintercept = avg_poss, linetype = "dashed", color = "#aaaaaa", linewidth = 0.5) +
  geom_vline(xintercept = avg_ppp,  linetype = "dashed", color = "#aaaaaa", linewidth = 0.5) +
  
  # Headshots
  geom_image(aes(image = headshot_url), size = 0.065, asp = 1.4) +
  
  # Quadrant labels
  annotate("text", x = max(transition_stats$PPP) - 0.01, y = max(transition_stats$POSS) - 0.5,
           label = "High Volume · High Efficiency", hjust = 1, size = 3,
           color = "#27ae60", fontface = "bold") +
  annotate("text", x = min(transition_stats$PPP) + 0.01, y = min(transition_stats$POSS) + 0.5,
           label = "Low Volume · Low Efficiency", hjust = 0, size = 3,
           color = "#e74c3c", fontface = "bold") +
  annotate("text", x = max(transition_stats$PPP) - 0.01, y = min(transition_stats$POSS) + 0.5,
           label = "Low Volume · High Efficiency", hjust = 1, size = 3,
           color = "#aaaaaa", fontface = "italic") +
  annotate("text", x = min(transition_stats$PPP) + 0.01, y = max(transition_stats$POSS) - 0.5,
           label = "High Volume · Low Efficiency", hjust = 0, size = 3,
           color = "#aaaaaa", fontface = "italic") +
  
  # Scales
  scale_x_continuous(
    name   = "Points Per Possession (PPP)",
    breaks = seq(0.6, 1.6, by = 0.1),
    limits = c(0.60, 1.58)
  ) +
  scale_y_continuous(
    name   = "Possessions (POSS)",
    breaks = seq(18, 46, by = 4),
    limits = c(18, 46)
  ) +
  
  # Title & caption
  labs(
    title    = "Transition Chance Efficiency",
    subtitle = "Players with 20+ Transition Possessions | 2025 NBA Playoffs",
    caption  = "Dashed lines = averages  |  Data via Second Spectrum"
  ) +
  
  # Theme
  theme_minimal(base_family = "Arial") +
  theme(
    plot.background    = element_rect(fill = "#faf8f5", color = NA),
    panel.background   = element_rect(fill = "#faf8f5", color = NA),
    panel.grid.major   = element_line(color = "#e8e4df", linewidth = 0.4),
    panel.grid.minor   = element_blank(),
    plot.title         = element_text(size = 18, face = "bold",   color = "#2c3e50",
                                      margin = margin(b = 4)),
    plot.subtitle      = element_text(size = 12, color = "#7f8c8d", margin = margin(b = 12)),
    plot.caption       = element_text(size = 9,  color = "#aaaaaa", hjust = 0),
    axis.title         = element_text(size = 11, color = "#2c3e50", face = "bold"),
    axis.text          = element_text(size = 9,  color = "#555555"),
