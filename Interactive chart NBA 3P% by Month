# JavaScript: on hover, color the whole hovered trace; reset all others to grey
js <- "
function(el) {
  var teamColors = %s;
  var greyColor  = '#BDBDBD';

  el.on('plotly_hover', function(data) {
    var hoveredTrace = data.points[0].curveNumber;
    var traceCount   = el.data.length;
    var colorUpdate  = { 'line.color': [], 'marker.color': [], 'line.width': [], 'opacity': [] };

    for (var i = 0; i < traceCount; i++) {
      if (i === hoveredTrace) {
        var team  = el.data[i].name;
        var color = teamColors[team] || greyColor;
        colorUpdate['line.color'].push(color);
        colorUpdate['marker.color'].push(color);
        colorUpdate['line.width'].push(3.5);
        colorUpdate['opacity'].push(1);
      } else {
        colorUpdate['line.color'].push(greyColor);
        colorUpdate['marker.color'].push(greyColor);
        colorUpdate['line.width'].push(1);
        colorUpdate['opacity'].push(0.25);
      }
    }
    Plotly.restyle(el, colorUpdate);
  });

  el.on('plotly_unhover', function() {
    var traceCount  = el.data.length;
    var colorReset  = { 'line.color': [], 'marker.color': [], 'line.width': [], 'opacity': [] };
    for (var i = 0; i < traceCount; i++) {
      colorReset['line.color'].push(greyColor);
      colorReset['marker.color'].push(greyColor);
      colorReset['line.width'].push(1.5);
      colorReset['opacity'].push(1);
    }
    Plotly.restyle(el, colorReset);
  });
}
"

# Inject team colors as JSON into the JS string
colors_json <- paste0(
  "{",
  paste(sprintf('"%s": "%s"', names(team_colors), team_colors), collapse = ", "),
  "}"
)
js_final <- sprintf(js, colors_json)

