    add_trace(
      data       = df,
      x          = ~Month,
      y          = ~Three_PCT,
      type       = "scatter",
      mode       = "lines+markers",
      name       = team,
      line       = list(color = "#BDBDBD", width = 1.5),
      marker     = list(color = "#BDBDBD", size = 6),
      customdata = matrix(rep(c(team, color), nrow(df)), ncol = 2, byrow = TRUE),
      hovertemplate = paste0(
        "<b>", team, "</b><br>",
        "%{x}: %{y:.1f}%",
        "<extra></extra>"
