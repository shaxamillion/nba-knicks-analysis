# Verify lengths
stopifnot(nrow(data) == 92)

# Sequential index and phase
data <- data %>%
  arrange(GM) %>%
  mutate(
    Game_seq = row_number(),
    Phase    = ifelse(GM <= 82, "Regular Season", "Playoffs")
  )

playoff_seq <- data$Game_seq[data$GM == 84]

# Long format
data_long <- data %>%
  select(Game_seq, GM, Phase, Playcall, Motion, Freelance) %>%
  pivot_longer(
    cols      = c(Playcall, Motion, Freelance),
    names_to  = "Metric",
    values_to = "Pct"
  ) %>%
  mutate(Metric = recode(Metric,
                         "Playcall"  = "Set / Play-Call",
                         "Motion"    = "Motion Offense",
                         "Freelance" = "Freelance"))

metric_colors <- c(
  "Set / Play-Call" = "#0051BA",
  "Motion Offense"  = "#10B981",
  "Freelance"       = "#F59E0B"
)

# Averages
reg_avgs <- data_long %>%
  filter(Phase == "Regular Season") %>%
  group_by(Metric) %>%
  summarise(Avg = mean(Pct, na.rm = TRUE), .groups = "drop")

playoff_avgs <- data_long %>%
  filter(Phase == "Playoffs") %>%
  group_by(Metric) %>%
  summarise(Avg = mean(Pct, na.rm = TRUE), .groups = "drop")

ggplot(data_long, aes(x = Game_seq, y = Pct,
                      color = Metric, fill = Metric)) +
  
  # ── Playoff shading ──────────────────────────────────────────────────
  annotate("rect",
           xmin = playoff_seq - 0.5, xmax = max(data$Game_seq) + 0.5,
           ymin = 0, ymax = 63,
           fill = "#FFF7ED", alpha = 0.7) +
  
  annotate("text", x = playoff_seq + 0.4, y = 61,
           label = "◀  Playoffs",
           hjust = 0, size = 3.2, color = "#E07B00", fontface = "bold") +
  
  geom_vline(xintercept = playoff_seq - 0.5,
             linetype = "dashed", color = "#E07B00",
             linewidth = 0.9, alpha = 0.8) +
  
  # ── Regular season avg lines ─────────────────────────────────────────
  geom_segment(data = reg_avgs,
               aes(x = 0.5, xend = playoff_seq - 0.5,
                   y = Avg, yend = Avg, color = Metric),
               linetype = "dotted", linewidth = 0.6,
               alpha = 0.5, inherit.aes = FALSE) +
  
  geom_text(data = reg_avgs,
            aes(x = 1, y = Avg + 2.5,
                label = paste0("RS: ", round(Avg, 1), "%"),
                color = Metric),
            hjust = 0, size = 2.3, fontface = "italic",
            inherit.aes = FALSE) +
  
  # ── Raw lines ────────────────────────────────────────────────────────
  geom_line(alpha = 0.18, linewidth = 0.6) +
  
  # ── LOESS trend ──────────────────────────────────────────────────────
  geom_smooth(method = "loess", span = 0.22, se = TRUE,
              linewidth = 1.8, alpha = 0.10) +
  
  # ── Playoff points ───────────────────────────────────────────────────
  geom_point(data = filter(data_long, Phase == "Playoffs"),
             aes(fill = Metric),
             shape = 21, size = 3.5,
             color = "white", stroke = 1.4,
             inherit.aes = TRUE) +
  
  # ── Playoff avg labels ───────────────────────────────────────────────
  geom_text(data = playoff_avgs,
            aes(x = max(data$Game_seq) + 0.5,
                y = Avg,
                label = paste0(round(Avg, 1), "%"),
                color = Metric),
            hjust = 0, size = 2.8, fontface = "bold",
            inherit.aes = FALSE) +
  
  # ── Scales ───────────────────────────────────────────────────────────
  scale_color_manual(values = metric_colors) +
  scale_fill_manual(values  = metric_colors) +
  
  scale_x_continuous(
    name   = "Game",
    breaks = c(seq(1, 82, 10), playoff_seq),
    labels = c(paste0("G", seq(1, 82, 10)), "PO"),
    expand = c(0.01, 0)
  ) +
  scale_y_continuous(
    name   = "Frequency %",
    breaks = seq(0, 60, 10),
    labels = function(x) paste0(x, "%"),
    limits = c(0, 64),
    expand = c(0, 0)
  ) +
  
  labs(
    title    = "Knicks Playcalling Frequencies — 2025-26 Season",
    subtitle = "Set / Play-Call  ·  Motion Offense  ·  Freelance  ·  Game by game with LOESS trend",
    caption  = "Data & Visual by ShaxNBA",
    color    = NULL,
    fill     = NULL
  ) +
  
  theme_minimal(base_size = 12, base_family = "sans") +
  theme(
    plot.background    = element_rect(fill = "#FAF9F6", color = NA),
    panel.background   = element_rect(fill = "#FFFFFF", color = NA),
